{
  "name": "zilo",
  "version": "1.0.0",
  "description": "Procesador de PDFs",
  "main": "main.js",
  "author": "Pablo Couse Pena",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "build": "build.bat"
  },
  "devDependencies": {
    "electron": "^38.3.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.pablocouse.zilo",
    "productName": "Zilo",
    "directories": {
      "output": "dist-build"
    },
    "files": [
      "main.js",
      "preload.js",
      "search-preload.js",
      "settings-preload.js",
      "manual-rename-preload.js",
      "license-preload.js",
      "admin-panel-preload.js",
      "ocr-zonal-preload.js",
      "license-manager.js",
      "ocr-zonal-engine.js",
      "ml-engine.js",
      "renderer/**/*",
      "build/icon.png",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "node-machine-id": "^1.1.12"
  }
}
